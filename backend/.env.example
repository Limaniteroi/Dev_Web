# Copie para backend/.env (não versionado) e ajuste.
# Gateway e Worker leem este arquivo automaticamente ao rodar da pasta backend/ ou da pasta do módulo.

# --- RabbitMQ (use 127.0.0.1 no Windows: "localhost" pode cair no IPv6 do WSL) ---
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app

# --- LLM (Worker) ---
# openai  -> precisa de OPENAI_API_KEY (pago, ~5 s por resposta)
# ollama  -> modelo local gratuito. Recomendado: Ollama para Windows (usa a GPU), na porta 11434.
#            Sem GPU/Ollama instalado: docker compose --profile ollama up -d ollama  e use a porta 11435.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen3.5:4b (~3,4 GB): boa qualidade em PT-BR; ~17 tokens/s numa RX 570 de 8 GB.
# Em máquinas só com CPU, prefira qwen3.5:2b ou OpenAI.
OLLAMA_MODEL=qwen3.5:4b
# Modelos "thinking" (Qwen3.5) gastam o orçamento de tokens raciocinando; deixe false
LLM_THINKING=false
# never: Worker não depende do Ollama para iniciar (baixe o modelo com "ollama pull")
OLLAMA_PULL_STRATEGY=never
LLM_MAX_TOKENS=2048
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_MS=2000
WORKER_CONCURRENCY=2

# --- Gateway ---
GATEWAY_PORT=8080
# Origens CORS (só para chamadas diretas ao Gateway, sem proxy). Padrão: localhost/127.0.0.1 nas portas 5173 e 3000
# FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Segredo HMAC do JWT: mínimo 32 caracteres. Gere um aleatório para produção.
JWT_SECRET=troque-este-segredo-de-desenvolvimento-com-32+chars
JWT_TTL=8h
# Senha dos usuários de demonstração "aluno" e "professor"
DEMO_PASSWORD=senha123
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_MAX_PENDING=3
